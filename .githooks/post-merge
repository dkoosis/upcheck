#!/usr/bin/env bash
# post-merge — tracked hook (shape B). core.hooksPath points at .githooks; `conform --local`
# checks that it does.
set -euo pipefail

# BEGIN BEADS INTEGRATION
# Hand the event to bd's shim when this clone is hydrated. A clone without
# bd installed skips the delegation rather than blocking the commit.
if [ -x ".beads/hooks/post-merge" ]; then
  ".beads/hooks/post-merge" "$@"
fi
# END BEADS INTEGRATION
