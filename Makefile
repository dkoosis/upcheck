# upcheck Makefile — the fleet four-verb contract.
# Generated by `repo-standard init`; repo-standard checks it on every `make check`.

.DEFAULT_GOAL := check

SHELL := /bin/bash
.SHELLFLAGS := -euo pipefail -c

.PHONY: check audit help vet lint test build standard race fuzz dupe nilcheck deadcode omitempty vuln clean

# Tool pins: bumping one is a deliberate PR. These are tools run with go run /
# npx, not runtime imports — the zero-dependency rule in
# .claude/rules/standard-repo.md is about go list -deps.
REPO_STANDARD_VER := v0.4.0
OMITEMPTYSCALAR_VER := v0.4.0
GOVULNCHECK_VER := v1.9.0
NILAWAY_VER := v0.0.0-20260918162853-acb8859b9031
DEADCODE_VER := v0.52.0
JSCPD_VER := 5.1.2
FUZZTIME ?= 10s

help: ## Show this help — the 3 verbs, identical in every dkoosis repo
	@awk 'BEGIN {FS = ":.*##"} /^[a-zA-Z0-9_.-]+:.*?## / { printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2 }' $(MAKEFILE_LIST)

check: vet lint test build standard ## Fast gate — vet + lint + test + build + repo-standard. Pre-commit; required in CI.
	@echo "=== check pass ==="

audit: check race fuzz dupe nilcheck deadcode omitempty vuln ## Exhaustive validation — the gate, plus race, fuzz, dupe, nilcheck, deadcode, omitempty and vuln
	@echo "=== audit pass ==="

vet: ## Run go vet
	go vet ./...

lint: ## Run golangci-lint (version pinned in .sandbox/project.conf)
	golangci-lint run ./...

test: ## Run tests with coverage
	go test -cover ./...

build: ## Compile everything
	go build ./...

standard: ## Run repo-standard (fleet SDLC checker) against this repo
	go run github.com/dkoosis/repo-standard/cmd/repo-standard@$(REPO_STANDARD_VER)

race: ## Run tests with the race detector (fresh run)
	go test -race -count=1 -cover ./...

# Runs each Fuzz function it finds, FUZZTIME apiece.
fuzz: ## Fuzz every Fuzz test (FUZZTIME=10s each)
	@set -e; \
	for pkg in $$(go list ./...); do \
		for f in $$(go test -list '^Fuzz' $$pkg | sed -n '/^Fuzz/p'); do \
			echo "fuzz $$pkg $$f"; \
			go test -run '^$$' -fuzz "^$$f$$" -fuzztime=$(FUZZTIME) $$pkg; \
		done; \
	done

dupe: ## Check for code duplication (jscpd, pinned)
	npx --yes jscpd@$(JSCPD_VER) . --threshold 3 --silent --reporters console --ignore "**/.git/**,**/.sandbox/**,**/.beads/**"

nilcheck: ## Run nilaway (pinned)
	go run go.uber.org/nilaway/cmd/nilaway@$(NILAWAY_VER) -include-pkgs=github.com/dkoosis/upcheck ./...

# deadcode lists each function no path from a root reaches, and exits 0 either
# way, so the target fails on any output. upcheck is a library with no main:
# -test makes the tests the roots.
deadcode: ## Fail on any function unreachable from the tests (deadcode)
	@out=$$(go run golang.org/x/tools/cmd/deadcode@$(DEADCODE_VER) -test ./...) || { echo "deadcode: could not run"; exit 1; }; \
	if [ -n "$$out" ]; then echo "$$out"; echo "deadcode: the functions above are unreachable; cut them"; exit 1; fi

# omitemptyscalar exits 3 on a ,omitempty tag on a bool (a false lost on write).
omitempty: ## Fail on a bool field tagged omitempty (omitemptyscalar)
	go run github.com/dkoosis/repo-standard/cmd/omitemptyscalar@$(OMITEMPTYSCALAR_VER) ./...

vuln: ## Scan for known vulnerabilities (govulncheck, pinned)
	go run golang.org/x/vuln/cmd/govulncheck@$(GOVULNCHECK_VER) ./...

clean: ## Remove sandbox build artifacts (upcheck is a library — no binary to remove)
	@rm -rf .sandbox/bin/linux-amd64 .sandbox/bin/linux-arm64 .sandbox/cache
	@echo "=== clean ==="
